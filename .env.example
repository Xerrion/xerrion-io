# PostgreSQL container config
POSTGRES_USER=xerrion
POSTGRES_PASSWORD=changeme
POSTGRES_DB=xerrion

# Database (PostgreSQL) - composed from the variables above in docker-compose
DATABASE_URL=postgresql://xerrion:changeme@db:5432/xerrion

# Cache (Redis)
REDIS_URL=redis://redis:6379

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-r2-public-domain.com

# GitHub API (for projects page)
GITHUB_TOKEN=

# Analytics (public - use PUBLIC_ prefix)
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_GA_MEASUREMENT_ID=

# Error reporting. Supports Sentry and GlitchTip DSNs. Leave empty to disable.
PUBLIC_SENTRY_DSN=
# Optional server override. Defaults to PUBLIC_SENTRY_DSN.
SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=production
PUBLIC_SENTRY_RELEASE=

# Build-only source map upload. Never expose the token with a PUBLIC_ prefix.
SENTRY_AUTH_TOKEN=
SENTRY_URL=
SENTRY_ORG=
SENTRY_PROJECT=

# Pocket ID admin login. Leave all values empty to use the local password login.
# Once any value is set, password login and existing password sessions are disabled.
POCKET_ID_ISSUER=
POCKET_ID_CLIENT_ID=
POCKET_ID_CLIENT_SECRET=
POCKET_ID_REDIRECT_URI=
POCKET_ID_ADMIN_SUBJECTS=
